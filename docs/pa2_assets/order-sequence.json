{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "RESTO SYSTEM — Registro de un producto en el pedido",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1000, 980]
  },
  "participants": [
    {"id":"actor","type":"external","label":"Operador","sublabel":"roles POS"},
    {"id":"ui","type":"frontend","label":"Pantalla POS","sublabel":"order.blade.php"},
    {"id":"route","type":"security","label":"Control de ruta","sublabel":"auth/module/permission"},
    {"id":"controller","type":"backend","label":"PosController","sublabel":"addToOrder"},
    {"id":"policy","type":"security","label":"OrderPolicy","sublabel":"view/update"},
    {"id":"service","type":"backend","label":"WorkflowService","sublabel":"addProduct"},
    {"id":"db","type":"database","label":"Base de datos","sublabel":"transacción"}
  ],
  "segments": [
    {"from":150,"to":355,"label":"Solicitud y autorización"},
    {"from":375,"to":760,"label":"Transacción del pedido"},
    {"from":780,"to":915,"label":"Respuesta"}
  ],
  "messages": [
    {"id":"select","from":"actor","to":"ui","y":190,"label":"selecciona producto"},
    {"id":"post","from":"ui","to":"route","y":235,"label":"POST /pos/order/{table}/add + CSRF","variant":"emphasis"},
    {"id":"authorized-route","from":"route","to":"controller","y":285,"label":"sesión, módulo y pos.manage válidos","variant":"security"},
    {"id":"existing-order","from":"controller","to":"policy","y":330,"label":"autorizar pedido existente","variant":"security","note":"Sin permiso: HTTP 403"},
    {"id":"invoke-service","from":"controller","to":"service","y":405,"label":"addProduct(table, product, user)","variant":"emphasis"},
    {"id":"lock-table","from":"service","to":"db","y":455,"label":"BEGIN + lockForUpdate(table)"},
    {"id":"table-state","from":"db","to":"service","y":500,"label":"mesa activa / datos actuales","variant":"return","note":"Mesa inactiva: validación 422 y rollback"},
    {"id":"lock-order","from":"service","to":"db","y":550,"label":"buscar y bloquear order pending"},
    {"id":"create-order","from":"service","to":"db","y":610,"label":"INSERT orders si no existe","variant":"emphasis","note":"Resuelve y conserva el camarero responsable"},
    {"id":"save-detail","from":"service","to":"db","y":665,"label":"INSERT detail o incrementar quantity","variant":"emphasis"},
    {"id":"recalculate","from":"service","to":"db","y":715,"label":"ocupar mesa + actualizar total"},
    {"id":"commit","from":"db","to":"service","y":755,"label":"COMMIT + pedido actualizado","variant":"return"},
    {"id":"return-controller","from":"service","to":"controller","y":805,"label":"Order","variant":"return"},
    {"id":"cart-html","from":"controller","to":"ui","y":850,"label":"HTTP 200 + HTML parcial del carrito","variant":"return"},
    {"id":"render","from":"ui","to":"actor","y":895,"label":"carrito actualizado","variant":"return"}
  ],
  "activations": [
    {"participant":"ui","from":225,"to":905,"type":"frontend"},
    {"participant":"controller","from":280,"to":860,"type":"backend"},
    {"participant":"policy","from":320,"to":350,"type":"security"},
    {"participant":"service","from":395,"to":815,"type":"backend"},
    {"participant":"db","from":445,"to":765,"type":"database"}
  ],
  "cards": [
    {"dot":"emerald","title":"Consistencia","items":["La mesa y el pedido se bloquean dentro de una transacción","El precio se copia al detalle y luego se recalcula el total"]},
    {"dot":"rose","title":"Alternativas","items":["403 si el actor no puede operar el pedido","422 para mesa inactiva o camarero incompatible","404 si product_id no existe"]},
    {"dot":"orange","title":"Brecha comprobada","items":["El alta por clic no valida formalmente product_id","Tampoco revalida activo/vendible en el servidor"]}
  ]
}
